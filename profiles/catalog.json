    {
      "family_id": "identity-architecture",
      "name": "Identity and device authorization architecture",
      "cardinality": "at-most-one",
      "description": "Versioned alternatives for authorizing devices that can receive end-to-end protected content. Product conformance requires one when identity/device management is in scope."
    },
    {
      "family_id": "pairwise-e2ee",
      "name": "Pairwise end-to-end encryption",
      "cardinality": "at-most-one",
      "description": "Complete asynchronous one-to-one session profiles combining a published prekey initialization protocol with a ratcheting protocol. Product conformance requires one when pairwise E2EE is in scope."
    },
    {
      "family_id": "group-e2ee",
      "name": "Group end-to-end encryption",
      "cardinality": "at-most-one",
      "description": "Complete group-messaging architecture profiles for asynchronous multi-device groups. Product conformance requires one when group E2EE is in scope."
    },
    {
      "family_id": "key-verification",
      "name": "Manual key verification",
      "cardinality": "at-most-one",
      "description": "Versioned manual verification profiles that bind an out-of-band safety number/QR representation either to stable account-root identities or to the complete active device-key sets."
    },
    {
      "family_id": "key-transparency",
      "name": "Key transparency",
      "cardinality": "at-most-one",
      "description": "Versioned Key Transparency deployment profiles that detect inconsistent or rolled-back cryptographic identity-directory views."
    },
    {
      "family_id": "backup-recovery",
      "name": "Backup and recovery",
      "cardinality": "at-most-one",
      "description": "Mutually exclusive E2EE backup/recovery architectures covering no recoverable backup, user-secret recovery, and hardware/HSM-assisted recovery."
    }
  ],
