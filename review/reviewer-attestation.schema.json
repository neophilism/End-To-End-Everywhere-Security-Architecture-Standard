{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reviewer_id",
    "reviewer_name",
    "organization_id",
    "organization_name",
    "independent_from_maintainers",
    "relationship_disclosure",
    "expertise",
    "domains",
    "candidate",
    "review_started_at",
    "review_completed_at",
    "methods_used",
    "areas_emphasized",
    "scope_limitations",
    "finding_ids",
    "overall_conclusion",
    "final_reviewed_tree_digest",
    "final_acceptance"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "reviewer_id": {
      "type": "string",
      "minLength": 1
    },
    "reviewer_name": {
      "type": "string",
      "minLength": 1
    },
    "organization_id": {
      "type": "string",
      "minLength": 1
    },
    "organization_name": {
      "type": "string",
      "minLength": 1
    },
    "independent_from_maintainers": {
      "const": true
    },
    "relationship_disclosure": {
      "type": "string",
      "minLength": 1
    },
    "expertise": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "cryptography-protocols",
          "implementation-security",
          "supply-chain-development",
          "privacy-metadata-recovery",
          "conformance-standards"
        ]
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_version",
        "tree_digest",
        "file_count"
      ],
      "properties": {
        "release_version": {
          "const": "0.9.0-rc.1"
        },
        "tree_digest": {
          "const": "sha256:9d546433dde60d3157e2adb3d9c630dbc36fd92c551083f5f5189491370ce2a2"
        },
        "file_count": {
          "const": 645
        }
      }
    },
    "review_started_at": {
      "type": "string",
      "minLength": 1
    },
    "review_completed_at": {
      "type": "string",
      "minLength": 1
    },
    "methods_used": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "areas_emphasized": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scope_limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "finding_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "overall_conclusion": {
      "type": "string",
      "minLength": 1
    },
    "final_reviewed_tree_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "final_acceptance": {
      "type": [
        "boolean",
        "null"
      ]
    }
  }
}
