{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","review_id","candidate","status","reviewers","findings","completion"],
  "properties":{
    "schema_version":{"const":"0.1"},
    "review_id":{"type":"string","minLength":1},
    "candidate":{
      "type":"object","additionalProperties":false,
      "required":["release_version","tree_digest","file_count"],
      "properties":{
        "release_version":{"const":"0.9.0-rc.1"},
        "tree_digest":{"const":"sha256:9d546433dde60d3157e2adb3d9c630dbc36fd92c551083f5f5189491370ce2a2"},
        "file_count":{"const":645}
      }
    },
    "status":{"enum":["awaiting-review","review-in-progress","findings-open","ready-for-1.0"]},
    "reviewers":{
      "type":"array","items":{
        "type":"object","additionalProperties":false,
        "required":["reviewer_id","organization_id","independent_from_maintainers","domains","attestation_digest","attestation_reference"],
        "properties":{
          "reviewer_id":{"type":"string","minLength":1},
          "organization_id":{"type":"string","minLength":1},
          "independent_from_maintainers":{"const":true},
          "domains":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["cryptography-protocols","implementation-security","supply-chain-development","privacy-metadata-recovery","conformance-standards"]}},
          "attestation_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
          "attestation_reference":{"type":"string","minLength":1}
        }
      }
    },
    "findings":{
      "type":"array","items":{
        "type":"object","additionalProperties":false,
        "required":["finding_id","reviewer_id","severity","title","analysis","affected_requirement_ids","affected_paths","recommendation","status","disposition_rationale","fix_reference","reviewer_acceptance"],
        "properties":{
          "finding_id":{"type":"string","minLength":1},
          "reviewer_id":{"type":"string","minLength":1},
          "severity":{"enum":["blocker","critical","high","medium","low","informational"]},
          "title":{"type":"string","minLength":1},
          "analysis":{"type":"string","minLength":1},
          "affected_requirement_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^REQ-[0-9a-f]{64}$"}},
          "affected_paths":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
          "recommendation":{"type":"string","minLength":1},
          "status":{"enum":["open","fixed","deferred","rejected"]},
          "disposition_rationale":{"type":["string","null"]},
          "fix_reference":{"type":["string","null"]},
          "reviewer_acceptance":{"type":["boolean","null"]}
        }
      }
    },
    "completion":{
      "type":"object","additionalProperties":false,
      "required":["review_complete","completed_at","summary_digest","summary_reference"],
      "properties":{
        "review_complete":{"type":"boolean"},
        "completed_at":{"type":["string","null"]},
        "summary_digest":{"type":["string","null"],"pattern":"^sha256:[0-9a-f]{64}$"},
        "summary_reference":{"type":["string","null"]}
      }
    }
  }
}
