{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://endtoendeverywhere.org/e2eesa/review/automated-review-evidence.schema.json",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "schema_version","evidence_kind","candidate","reviewer_id","organization_id",
    "started_at","finished_at","environment","human_review_required","human_review_note",
    "all_automated_checks_passed","commands","report_digest"
  ],
  "properties":{
    "schema_version":{"const":"0.1"},
    "evidence_kind":{"const":"automated-review-support"},
    "candidate":{
      "type":"object","additionalProperties":false,
      "required":["release_version","tree_digest","file_count"],
      "properties":{
        "release_version":{"const":"0.9.0-rc.1"},
        "tree_digest":{"const":"sha256:9d546433dde60d3157e2adb3d9c630dbc36fd92c551083f5f5189491370ce2a2"},
        "file_count":{"const":645}
      }
    },
    "reviewer_id":{"type":["string","null"]},
    "organization_id":{"type":["string","null"]},
    "started_at":{"type":"string","minLength":1},
    "finished_at":{"type":"string","minLength":1},
    "environment":{
      "type":"object","additionalProperties":false,
      "required":["python_version","python_implementation","platform"],
      "properties":{
        "python_version":{"type":"string","minLength":1},
        "python_implementation":{"type":"string","minLength":1},
        "platform":{"type":"string","minLength":1}
      }
    },
    "human_review_required":{"const":true},
    "human_review_note":{"type":"string","minLength":1},
    "all_automated_checks_passed":{"type":"boolean"},
    "commands":{
      "type":"array","minItems":5,"items":{
        "type":"object","additionalProperties":false,
        "required":[
          "id","purpose","argv","started_at","finished_at","return_code","passed",
          "stdout_sha256","stderr_sha256","stdout","stderr"
        ],
        "properties":{
          "id":{"type":"string","minLength":1},
          "purpose":{"type":"string","minLength":1},
          "argv":{"type":"array","minItems":2,"items":{"type":"string"}},
          "started_at":{"type":"string","minLength":1},
          "finished_at":{"type":"string","minLength":1},
          "return_code":{"type":"integer"},
          "passed":{"type":"boolean"},
          "stdout_sha256":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
          "stderr_sha256":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
          "stdout":{"type":"string"},
          "stderr":{"type":"string"}
        }
      }
    },
    "report_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  }
}
