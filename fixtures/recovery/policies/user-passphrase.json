{
  "schema_version": "0.1",
  "require_authorized_restoring_device": true,
  "require_manifest_authentication": true,
  "require_fresh_backup_key_per_generation": true,
  "require_generation_rollback_protection": true,
  "allow_server_plaintext": false,
  "allow_server_unwrapped_backup_key": false,
  "policy_id": "backup-passphrase",
  "profile_ref": "backup-user-secret@0.1.0",
  "content_aead_algorithm_id": "ALG-CHACHA20-POLY1305",
  "secret_kdf_algorithm_id": "ALG-ARGON2ID",
  "secret_hkdf_algorithm_id": "ALG-HKDF-SHA256",
  "recovery_secret_type": "user-chosen-passphrase",
  "minimum_generated_secret_bits": null,
  "argon2_version": "0x13",
  "argon2_memory_kib": 65536,
  "argon2_iterations": 3,
  "argon2_parallelism": 4,
  "argon2_salt_bytes": 16,
  "argon2_output_bytes": 32,
  "hardware_assistance": false,
  "hardware_wrap_aead_algorithm_id": null,
  "hardware_module_assurance": "none",
  "require_non_exportable_hardware_key": false,
  "require_hardware_attestation": false,
  "require_hardware_rate_limiting": false
}
