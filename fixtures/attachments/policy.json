{
  "schema_version": "0.1",
  "policy_id": "attachment-default",
  "profile_ref": "attachment-chunked-aead@0.1.0",
  "content_aead_algorithm_id": "ALG-AES-256-GCM",
  "hash_algorithm_id": "ALG-SHA256",
  "attachment_key_bits": 256,
  "chunk_size_bytes": 1048576,
  "maximum_chunk_count": 1000000,
  "nonce_prefix_bytes": 4,
  "nonce_counter_bytes": 8,
  "require_fresh_attachment_key": true,
  "require_e2ee_manifest_delivery": true,
  "require_manifest_authentication": true,
  "require_chunk_aad_binding": true,
  "require_authorized_key_distribution": true,
  "allow_key_in_url": false,
  "allow_key_in_storage_metadata": false,
  "allow_server_plaintext": false,
  "allow_server_attachment_key": false,
  "require_delete_api": true,
  "require_orphan_cleanup": true,
  "require_no_global_recall_claim": true
}
