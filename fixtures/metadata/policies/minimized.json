{
  "schema_version": "0.1",
  "protocol_registry_version": "0.1.0",
  "prohibit_durable_social_graph": true,
  "prohibit_content_derived_service_metadata": true,
  "prohibit_stable_cross_service_identifier": true,
  "policy_id": "metadata-minimized",
  "profile_ref": "metadata-minimized@0.1.0",
  "max_post_delivery_metadata_retention_seconds": 86400,
  "max_service_source_ip_retention_seconds": 86400,
  "max_relay_source_ip_retention_seconds": null,
  "sender_hidden_required": false,
  "recipient_delivery_capability_required": false,
  "recipient_authenticates_sender_inside_e2ee": false,
  "relay_partition_required": false,
  "ohttp_required": false,
  "require_independent_relay_gateway": false,
  "require_authenticated_gateway_key_config": false,
  "require_nonpersonalized_gateway_key_config": false,
  "require_no_identifying_relay_headers": false,
  "require_ohttp_replay_protection": false,
  "ohttp_kem_algorithm_id": null,
  "ohttp_kdf_algorithm_id": null,
  "ohttp_aead_algorithm_id": null,
  "request_padding_mode": "none",
  "minimum_padding_multiple_bytes": null
}
