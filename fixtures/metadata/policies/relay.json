{
  "schema_version": "0.1",
  "protocol_registry_version": "0.1.0",
  "prohibit_durable_social_graph": true,
  "prohibit_content_derived_service_metadata": true,
  "prohibit_stable_cross_service_identifier": true,
  "policy_id": "metadata-relay",
  "profile_ref": "metadata-relay-partitioned@0.1.0",
  "max_post_delivery_metadata_retention_seconds": 3600,
  "max_service_source_ip_retention_seconds": 0,
  "max_relay_source_ip_retention_seconds": 0,
  "sender_hidden_required": true,
  "recipient_delivery_capability_required": true,
  "recipient_authenticates_sender_inside_e2ee": true,
  "relay_partition_required": true,
  "ohttp_required": true,
  "require_independent_relay_gateway": true,
  "require_authenticated_gateway_key_config": true,
  "require_nonpersonalized_gateway_key_config": true,
  "require_no_identifying_relay_headers": true,
  "require_ohttp_replay_protection": true,
  "ohttp_kem_algorithm_id": "ALG-HPKE-DHKEM-X25519-HKDF-SHA256",
  "ohttp_kdf_algorithm_id": "ALG-HKDF-SHA256",
  "ohttp_aead_algorithm_id": "ALG-AES-128-GCM",
  "request_padding_mode": "binary-http-padding",
  "minimum_padding_multiple_bytes": 256
}
