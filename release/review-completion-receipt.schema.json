{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "schema_version",
    "source_candidate_digest",
    "review_package_digest",
    "final_reviewed_tree_digest",
    "final_reviewed_commit",
    "review_summary_digest",
    "review_summary_reference",
    "reviewer_count",
    "organization_count",
    "review_domains",
    "finding_counts_by_severity",
    "receipt_digest"
  ],
  "properties":{
    "schema_version":{"const":"0.1"},
    "source_candidate_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "review_package_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "final_reviewed_tree_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "final_reviewed_commit":{"type":"string","minLength":1},
    "review_summary_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "review_summary_reference":{"type":"string","minLength":1},
    "reviewer_count":{"type":"integer","minimum":3},
    "organization_count":{"type":"integer","minimum":2},
    "review_domains":{"type":"array","minItems":5,"uniqueItems":true,"items":{"enum":[
      "cryptography-protocols",
      "implementation-security",
      "supply-chain-development",
      "privacy-metadata-recovery",
      "conformance-standards"
    ]}},
    "finding_counts_by_severity":{
      "type":"object",
      "additionalProperties":{"type":"integer","minimum":0}
    },
    "receipt_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  }
}
