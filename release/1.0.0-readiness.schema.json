{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target_release",
    "source_candidate",
    "engineering_status",
    "external_review_status",
    "external_review_package",
    "external_review_completion_command",
    "internal_gates",
    "external_gates",
    "promotion_actions_after_review"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "target_release": {"const": "1.0.0"},
    "source_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_version", "tree_digest", "file_count", "basis_standard_version"],
      "properties": {
        "release_version": {"const": "0.9.0-rc.1"},
        "tree_digest": {"const": "sha256:9d546433dde60d3157e2adb3d9c630dbc36fd92c551083f5f5189491370ce2a2"},
        "file_count": {"const": 645},
        "basis_standard_version": {"const": "0.1.0-dev"}
      }
    },
    "engineering_status": {
      "enum": ["ready-except-independent-review", "review-fixes-in-progress", "ready-for-final-promotion", "released"]
    },
    "external_review_status": {
      "enum": ["pending", "in-progress", "findings-open", "complete"]
    },
    "external_review_package": {"const": "review/independent-review.json"},
    "external_review_completion_command": {"type": "string", "minLength": 1},
    "internal_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "status", "evidence"],
        "properties": {
          "gate_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["passed", "pending", "failed"]},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "external_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "status", "blocking_for_final_release", "placeholder_note"],
        "properties": {
          "gate_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["pending", "in-progress", "complete"]},
          "blocking_for_final_release": {"type": "boolean"},
          "placeholder_note": {"type": "string", "minLength": 1}
        }
      }
    },
    "promotion_actions_after_review": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
