{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "schema_version",
    "source_reviewed_tree_digest",
    "source_standard_version",
    "target_release",
    "target_standard_version",
    "mapping_count",
    "changed_requirement_id_count",
    "mappings",
    "report_digest"
  ],
  "properties":{
    "schema_version":{"const":"0.1"},
    "source_reviewed_tree_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "source_standard_version":{"type":"string","minLength":1},
    "target_release":{"const":"1.0.0"},
    "target_standard_version":{"const":"1.0.0"},
    "mapping_count":{"type":"integer","minimum":1},
    "changed_requirement_id_count":{"type":"integer","minimum":0},
    "mappings":{"type":"array","minItems":1,"items":{
      "type":"object","additionalProperties":false,
      "required":[
        "document_path",
        "old_requirement_id",
        "new_requirement_id",
        "old_text_digest",
        "new_text_digest",
        "version_literal_changed"
      ],
      "properties":{
        "document_path":{"type":"string","pattern":"^spec/.+\\.md$"},
        "old_requirement_id":{"type":"string","pattern":"^REQ-[0-9a-f]{64}$"},
        "new_requirement_id":{"type":"string","pattern":"^REQ-[0-9a-f]{64}$"},
        "old_text_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
        "new_text_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
        "version_literal_changed":{"type":"boolean"}
      }
    }},
    "report_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  }
}
