{
  "schema_version": "0.1",
  "registry_version": "0.1.0",
  "standard_version": "0.1.0-dev",
  "mechanisms": [
    {
      "id": "SECRET-OS-KEYSTORE",
      "name": "Native OS keystore/keychain",
      "class": "platform-keystore",
      "status": "recommended",
      "specification": "Platform native keystore/keychain API",
      "reference_uri": "https://developer.android.com/privacy-and-security/keystore",
      "non_exportable_capable": true,
      "hardware_isolation_capable": true,
      "attestation_capable": "platform-dependent",
      "rollback_counter_capable": "platform-dependent",
      "notes": [
        "Hardware backing MUST be detected and evidenced before hardware-isolation claims are made."
      ]
    },
    {
      "id": "SECRET-APPLE-SECURE-ENCLAVE",
      "name": "Apple Secure Enclave",
      "class": "hardware-isolated",
      "status": "recommended",
      "specification": "Apple Secure Enclave key protection",
      "reference_uri": "https://developer.apple.com/documentation/security/protecting-keys-with-the-secure-enclave",
      "non_exportable_capable": true,
      "hardware_isolation_capable": true,
      "attestation_capable": "platform-dependent",
      "rollback_counter_capable": false,
      "notes": [
        "Private key operations remain inside the Secure Enclave; applications MUST NOT assume an app-visible monotonic counter exists."
      ]
    },
    {
      "id": "SECRET-ANDROID-TEE",
      "name": "Android Keystore Trusted Environment",
      "class": "hardware-isolated",
      "status": "recommended",
      "specification": "Android Keystore / KeyMint trusted environment",
      "reference_uri": "https://developer.android.com/privacy-and-security/keystore",
      "non_exportable_capable": true,
      "hardware_isolation_capable": true,
      "attestation_capable": true,
      "rollback_counter_capable": "platform-dependent",
      "notes": [
        "KeyInfo security level and attestation evidence distinguish hardware-backed keys from software-backed keystore keys."
      ]
    },
    {
      "id": "SECRET-ANDROID-STRONGBOX",
      "name": "Android StrongBox KeyMint",
      "class": "hardware-isolated",
      "status": "recommended",
      "specification": "Android StrongBox KeyMint",
      "reference_uri": "https://developer.android.com/privacy-and-security/keystore",
      "non_exportable_capable": true,
      "hardware_isolation_capable": true,
      "attestation_capable": true,
      "rollback_counter_capable": "platform-dependent",
      "notes": [
        "StrongBox provides a separate secure element/iSE security boundary with stronger isolation but tighter algorithm/performance constraints."
      ]
    },
    {
      "id": "SECRET-TPM2-V185",
      "name": "Trusted Platform Module 2.0",
      "class": "hardware-isolated",
      "status": "recommended",
      "specification": "TCG TPM 2.0 Library Specification Version 185",
      "reference_uri": "https://trustedcomputinggroup.org/resource/tpm-library-specification/",
      "non_exportable_capable": true,
      "hardware_isolation_capable": true,
      "attestation_capable": true,
      "rollback_counter_capable": true,
      "notes": [
        "TPM NV counters or equivalent monotonic NV state may be used as a rollback anchor when correctly provisioned and authorized."
      ]
    },
    {
      "id": "SECRET-PKCS11-3.2",
      "name": "PKCS #11 v3.2 token/HSM",
      "class": "external-token",
      "status": "allowed",
      "specification": "OASIS PKCS #11 Specification Version 3.2",
      "reference_uri": "https://docs.oasis-open.org/pkcs11/pkcs11-spec/v3.2/os/",
      "non_exportable_capable": true,
      "hardware_isolation_capable": true,
      "attestation_capable": "token-dependent",
      "rollback_counter_capable": "token-dependent",
      "notes": [
        "Conformance requires the selected key object to be non-extractable and the token security boundary to be documented."
      ]
    },
    {
      "id": "SECRET-SOFTWARE-VAULT",
      "name": "Encrypted software vault",
      "class": "software-vault",
      "status": "allowed",
      "specification": "E2EESA software fallback",
      "reference_uri": "https://www.rfc-editor.org/rfc/rfc9106.html",
      "non_exportable_capable": false,
      "hardware_isolation_capable": false,
      "attestation_capable": false,
      "rollback_counter_capable": false,
      "notes": [
        "Fallback only; uses Argon2id plus a registered AEAD and cannot claim hardware non-exportability."
      ]
    }
  ]
}
