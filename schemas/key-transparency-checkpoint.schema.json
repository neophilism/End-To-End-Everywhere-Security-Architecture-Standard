{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://e2eesa.example/schemas/key-transparency-checkpoint.schema.json",
  "title":"E2EESA retained key transparency checkpoint",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","log_id","tree_size","tree_root_hash","tree_timestamp_ms","subject_digest_hex","label_version"],
  "properties":{
    "schema_version":{"const":"0.1"},
    "log_id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "tree_size":{"type":"integer","minimum":1},
    "tree_root_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "tree_timestamp_ms":{"type":"integer","minimum":0},
    "subject_digest_hex":{"type":"string","pattern":"^[0-9a-f]{64,128}$"},
    "label_version":{"type":"integer","minimum":0}
  }
}
