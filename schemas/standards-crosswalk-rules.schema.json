{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"https://endtoendeverywhere.org/e2eesa/schemas/standards-crosswalk-rules.schema.json",
 "type":"object","additionalProperties":false,
 "required":["schema_version","crosswalk_version","rules"],
 "properties":{
  "schema_version":{"const":"0.1"},
  "crosswalk_version":{"type":"string","minLength":1},
  "rules":{"type":"array","minItems":1,"items":{
   "type":"object","additionalProperties":false,
   "required":["document_path","relations","no_direct_analog_reason"],
   "properties":{
    "document_path":{"type":"string","pattern":"^spec/.+\\.md$"},
    "relations":{"type":"array","items":{
     "type":"object","additionalProperties":false,
     "required":["standard_id","relation","scope_note"],
     "properties":{
      "standard_id":{"type":"string","minLength":1},
      "relation":{"enum":["direct","contextual"]},
      "scope_note":{"type":"string","minLength":1}
     }
    }},
    "no_direct_analog_reason":{"type":["string","null"]}
   }
  }}
 }
}
