{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://endtoendeverywhere.org/e2eesa/schemas/profile.schema.json",
  "title": "E2EESA Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "profile_version", "status", "decision_class", "security_properties"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "profile_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "status": {
      "type": "string",
      "enum": ["recommended", "allowed", "legacy", "deprecated", "prohibited", "provisional", "experimental"]
    },
    "decision_class": {
      "type": "string",
      "enum": ["invariant", "profile-choice", "capability", "experimental"]
    },
    "security_properties": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "requires": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true,
      "default": []
    },
    "incompatible_with": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true,
      "default": []
    },
    "notes": {
      "type": "string"
    }
  }
}
