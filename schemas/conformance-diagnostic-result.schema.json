{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://endtoendeverywhere.org/e2eesa/schemas/conformance-diagnostic-result.schema.json",
  "title": "E2EESA Legacy Configuration Diagnostic Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assessment_id",
    "request_digest",
    "conformance_policy_ref",
    "claim_scope",
    "verdict",
    "production_certification_eligible",
    "product_id",
    "product_version",
    "platform",
    "evaluated_at",
    "effective_profile_refs",
    "in_scope_family_ids",
    "required_promoted_profile_refs",
    "required_property_ids",
    "conditional_property_ids",
    "not_supported_property_ids",
    "input_digests",
    "reasons",
    "result_digest",
    "result_class",
    "evaluation_policy_scope"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "assessment_id": {
      "type": "string",
      "minLength": 1
    },
    "request_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "conformance_policy_ref": {
      "type": "string",
      "minLength": 1
    },
    "claim_scope": {
      "const": "configuration-diagnostic"
    },
    "verdict": {
      "enum": [
        "pass",
        "fail",
        "indeterminate"
      ]
    },
    "production_certification_eligible": {
      "type": "boolean"
    },
    "product_id": {
      "type": "string",
      "minLength": 1
    },
    "product_version": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "evaluated_at": {
      "type": "string",
      "minLength": 1
    },
    "effective_profile_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "in_scope_family_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_promoted_profile_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_property_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^SP-[A-Z0-9-]+$"
      }
    },
    "conditional_property_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^SP-[A-Z0-9-]+$"
      }
    },
    "not_supported_property_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^SP-[A-Z0-9-]+$"
      }
    },
    "input_digests": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "severity",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "severity": {
            "enum": [
              "error",
              "conditional",
              "info"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "result_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "result_class": {
      "const": "configuration"
    },
    "evaluation_policy_scope": {
      "enum": [
        "production-conformance",
        "candidate-evaluation",
        "migration-only"
      ]
    }
  }
}
