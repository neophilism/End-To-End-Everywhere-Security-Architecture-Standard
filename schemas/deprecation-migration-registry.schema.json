{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://endtoendeverywhere.org/e2eesa/schemas/deprecation-migration-registry.schema.json",
  "title":"E2EESA Deprecation Migration Registry",
  "type":"object","additionalProperties":false,
  "required":["schema_version","registry_version","modes","strategies","legacy_processing_policies","fallback_policies","reason_classes","dependent_actions","event_types"],
  "properties":{
    "schema_version":{"const":"0.1"},
    "registry_version":{"type":"string","minLength":1},
    "modes":{"type":"array","minItems":2,"uniqueItems":true,"items":{"enum":["planned","emergency"]}},
    "strategies":{"type":"array","minItems":3,"uniqueItems":true,"items":{"enum":["overlap-prefer-new","scheduled-cutover","emergency-stop"]}},
    "legacy_processing_policies":{"type":"array","minItems":3,"uniqueItems":true,"items":{"enum":["hard-cutoff","historical-read-verify-only","migration-only"]}},
    "fallback_policies":{"type":"array","minItems":2,"uniqueItems":true,"items":{"enum":["disabled","bounded-until-new-use-stop"]}},
    "reason_classes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "dependent_actions":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "event_types":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}}
  }
}
