{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://endtoendeverywhere.org/e2eesa/schemas/profile-catalog.schema.json",
  "title": "E2EESA Profile Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "standard_version",
    "families",
    "profiles"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "standard_version": {
      "type": "string",
      "minLength": 1
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "family_id",
          "name",
          "cardinality",
          "description"
        ],
        "properties": {
          "family_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "cardinality": {
            "type": "string",
            "enum": [
              "exactly-one",
              "at-most-one",
              "one-or-more",
              "many"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "profile.schema.json"
      }
    }
  }
}
