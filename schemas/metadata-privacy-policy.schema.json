{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://e2eesa.example/schemas/metadata-privacy-policy.schema.json",
  "title":"E2EESA metadata privacy policy",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "schema_version","policy_id","profile_ref","protocol_registry_version",
    "max_post_delivery_metadata_retention_seconds",
    "max_service_source_ip_retention_seconds",
    "max_relay_source_ip_retention_seconds",
    "prohibit_durable_social_graph","prohibit_content_derived_service_metadata",
    "prohibit_stable_cross_service_identifier",
    "sender_hidden_required","recipient_delivery_capability_required",
    "recipient_authenticates_sender_inside_e2ee",
    "relay_partition_required","ohttp_required",
    "require_independent_relay_gateway","require_authenticated_gateway_key_config",
    "require_nonpersonalized_gateway_key_config","require_no_identifying_relay_headers",
    "require_ohttp_replay_protection","ohttp_kem_algorithm_id",
    "ohttp_kdf_algorithm_id","ohttp_aead_algorithm_id",
    "request_padding_mode","minimum_padding_multiple_bytes"
  ],
  "properties":{
    "schema_version":{"const":"0.1"},
    "policy_id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "profile_ref":{"enum":["metadata-minimized@0.1.0","metadata-sender-hidden@0.1.0","metadata-relay-partitioned@0.1.0"]},
    "protocol_registry_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "max_post_delivery_metadata_retention_seconds":{"type":"integer","minimum":0},
    "max_service_source_ip_retention_seconds":{"type":"integer","minimum":0},
    "max_relay_source_ip_retention_seconds":{"oneOf":[{"type":"null"},{"type":"integer","minimum":0}]},
    "prohibit_durable_social_graph":{"const":true},
    "prohibit_content_derived_service_metadata":{"const":true},
    "prohibit_stable_cross_service_identifier":{"const":true},
    "sender_hidden_required":{"type":"boolean"},
    "recipient_delivery_capability_required":{"type":"boolean"},
    "recipient_authenticates_sender_inside_e2ee":{"type":"boolean"},
    "relay_partition_required":{"type":"boolean"},
    "ohttp_required":{"type":"boolean"},
    "require_independent_relay_gateway":{"type":"boolean"},
    "require_authenticated_gateway_key_config":{"type":"boolean"},
    "require_nonpersonalized_gateway_key_config":{"type":"boolean"},
    "require_no_identifying_relay_headers":{"type":"boolean"},
    "require_ohttp_replay_protection":{"type":"boolean"},
    "ohttp_kem_algorithm_id":{"oneOf":[{"type":"null"},{"type":"string","minLength":1}]},
    "ohttp_kdf_algorithm_id":{"oneOf":[{"type":"null"},{"type":"string","minLength":1}]},
    "ohttp_aead_algorithm_id":{"oneOf":[{"type":"null"},{"type":"string","minLength":1}]},
    "request_padding_mode":{"enum":["none","binary-http-padding"]},
    "minimum_padding_multiple_bytes":{"oneOf":[{"type":"null"},{"type":"integer","minimum":128}]},
    "notes":{"type":"string"}
  }
}
