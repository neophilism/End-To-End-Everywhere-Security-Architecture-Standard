{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://endtoendeverywhere.org/e2eesa/schemas/formal-verification-policy.schema.json",
  "title": "E2EESA Formal Verification Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "product_id", "product_version", "platform", "configuration", "obligations"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "policy_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "product_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "product_version": {"type": "string", "minLength": 1},
    "platform": {"type": "string", "minLength": 1},
    "configuration": {"$ref": "configuration.schema.json"},
    "obligations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["obligation_id", "formal_profile_ref", "property_ids", "threat_ids", "proof_scope", "require_machine_checking", "require_unbounded_sessions", "require_artifact_correspondence", "maximum_evidence_age_hours"],
        "properties": {
          "obligation_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "formal_profile_ref": {"type": "string", "pattern": "^formal-[a-z0-9-]+@[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "property_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^SP-[A-Z0-9-]+$"}
          },
          "threat_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^TM-[A-Z0-9-]+$"}
          },
          "proof_scope": {"type": "string", "minLength": 1},
          "require_machine_checking": {"type": "boolean"},
          "require_unbounded_sessions": {"type": "boolean"},
          "require_artifact_correspondence": {"type": "boolean"},
          "maximum_evidence_age_hours": {"type": "integer", "minimum": 1, "maximum": 8760}
        }
      }
    }
  }
}
