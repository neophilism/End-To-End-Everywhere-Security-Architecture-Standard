{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://endtoendeverywhere.org/e2eesa/schemas/server-trust-registry.schema.json",
  "title": "E2EESA server-trust-registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_version",
    "profile_ref",
    "service_key_purposes",
    "prohibited_server_holdings"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "registry_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "profile_ref": {
      "type": "string",
      "minLength": 1
    },
    "service_key_purposes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "tls-authentication",
          "metadata-at-rest",
          "abuse-control"
        ]
      },
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true
    },
    "prohibited_server_holdings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true
    }
  }
}
