{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://e2eesa.example/schemas/identity-state.schema.json",
  "title": "E2EESA identity and device state",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "key": {
      "type":"object","additionalProperties":false,
      "required":["key_id","algorithm_id","public_key_fingerprint"],
      "properties":{
        "key_id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "algorithm_id":{"type":"string","minLength":1},
        "public_key_fingerprint":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
      }
    },
    "device":{
      "type":"object","additionalProperties":false,
      "required":["device_id","status","key_generation","signing_key","agreement_key"],
      "properties":{
        "device_id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "status":{"enum":["active","revoked"]},
        "key_generation":{"type":"integer","minimum":1},
        "signing_key":{"$ref":"#/$defs/key"},
        "agreement_key":{"$ref":"#/$defs/key"}
      }
    }
  },
  "required":["schema_version","identity_id","sequence","account_root_key","devices","retired_key_ids"],
  "properties":{
    "schema_version":{"const":"0.1"},
    "identity_id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "sequence":{"type":"integer","minimum":0},
    "account_root_key":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/key"}]},
    "devices":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/device"}},
    "retired_key_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"}}
  }
}
