{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://e2eesa.example/schemas/requirement-analysis-registry.schema.json",
  "title": "E2EESA AUD-21 authored analyses and review provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_version",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "analysis_version": {
      "const": "0.1.0"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "logical": {
      "type": "string",
      "pattern": "^E2EESA-R-[0-9]{5}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "req": {
      "type": "string",
      "pattern": "^REQ-[0-9a-f]{64}$"
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_id",
        "requirement_id",
        "document_path",
        "text_digest",
        "author_id",
        "rationale",
        "threat_ids",
        "security_property_ids",
        "evidence_expectations",
        "external_standard_ids",
        "dependencies",
        "context_digest",
        "review"
      ],
      "properties": {
        "logical_id": {
          "$ref": "#/$defs/logical"
        },
        "requirement_id": {
          "$ref": "#/$defs/req"
        },
        "document_path": {
          "type": "string",
          "pattern": "^spec/[^/]+\\.md$"
        },
        "text_digest": {
          "$ref": "#/$defs/hash"
        },
        "author_id": {
          "$ref": "#/$defs/id"
        },
        "rationale": {
          "type": "string",
          "minLength": 60
        },
        "threat_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "security_property_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "evidence_expectations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "external_standard_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependency"
          }
        },
        "context_digest": {
          "$ref": "#/$defs/hash"
        },
        "review": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/review"
            }
          ]
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_id",
        "kind"
      ],
      "properties": {
        "logical_id": {
          "$ref": "#/$defs/logical"
        },
        "kind": {
          "enum": [
            "requires",
            "one-of",
            "excludes"
          ]
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_id",
        "reviewer_organization_id",
        "accepted_context_digest",
        "attestation_ref"
      ],
      "properties": {
        "reviewer_id": {
          "$ref": "#/$defs/id"
        },
        "reviewer_organization_id": {
          "$ref": "#/$defs/id"
        },
        "accepted_context_digest": {
          "$ref": "#/$defs/hash"
        },
        "attestation_ref": {
          "$ref": "#/$defs/id"
        }
      }
    }
  }
}
