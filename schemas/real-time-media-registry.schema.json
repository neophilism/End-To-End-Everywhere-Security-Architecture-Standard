{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://e2eesa.example/schemas/real-time-media-registry.schema.json",
  "title":"E2EESA real-time media protocol registry",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","registry_version","standard_version","protocol","cipher_suites","pending_updates"],
  "properties":{
    "schema_version":{"const":"0.1"},
    "registry_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "standard_version":{"type":"string","minLength":1},
    "protocol":{
      "type":"object","additionalProperties":false,
      "required":["id","name","status","specification","reference_uri","notes"],
      "properties":{
        "id":{"const":"SFRAME-RFC9605"},
        "name":{"type":"string","minLength":1},
        "status":{"enum":["recommended","allowed","legacy","deprecated","prohibited","provisional"]},
        "specification":{"const":"RFC 9605"},
        "reference_uri":{"type":"string","pattern":"^https://"},
        "notes":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}
      }
    },
    "cipher_suites":{
      "type":"array","minItems":5,
      "items":{
        "type":"object",
        "required":["id","name","status","nh","nka","nk","nn","nt","reference"],
        "properties":{
          "id":{"type":"string","pattern":"^0x[0-9A-Fa-f]{4}$"},
          "name":{"type":"string","minLength":1},
          "status":{"enum":["recommended","allowed","legacy","deprecated","prohibited"]},
          "nh":{"type":"integer","minimum":1},
          "nka":{"oneOf":[{"type":"null"},{"type":"integer","minimum":1}]},
          "nk":{"type":"integer","minimum":1},
          "nn":{"type":"integer","minimum":1},
          "nt":{"type":"integer","minimum":1},
          "reference":{"type":"string","minLength":1},
          "status_reason":{"type":"string"}
        },
        "additionalProperties":false
      }
    },
    "pending_updates":{
      "type":"array",
      "items":{
        "type":"object","additionalProperties":false,
        "required":["document","status","note"],
        "properties":{
          "document":{"type":"string","minLength":1},
          "status":{"type":"string","minLength":1},
          "note":{"type":"string","minLength":1}
        }
      }
    }
  }
}
