{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://e2eesa.example/schemas/backup-recovery-policy.schema.json",
  "title":"E2EESA backup and recovery policy",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "schema_version","policy_id","profile_ref",
    "content_aead_algorithm_id","secret_kdf_algorithm_id","secret_hkdf_algorithm_id",
    "recovery_secret_type","minimum_generated_secret_bits",
    "argon2_version","argon2_memory_kib","argon2_iterations","argon2_parallelism",
    "argon2_salt_bytes","argon2_output_bytes",
    "hardware_assistance","hardware_wrap_aead_algorithm_id","hardware_module_assurance",
    "require_non_exportable_hardware_key","require_hardware_attestation",
    "require_hardware_rate_limiting","require_authorized_restoring_device",
    "require_manifest_authentication","require_fresh_backup_key_per_generation",
    "require_generation_rollback_protection","allow_server_plaintext",
    "allow_server_unwrapped_backup_key"
  ],
  "properties":{
    "schema_version":{"const":"0.1"},
    "policy_id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "profile_ref":{"enum":["backup-none@0.1.0","backup-user-secret@0.1.0","backup-hardware-assisted@0.1.0"]},
    "content_aead_algorithm_id":{"oneOf":[{"type":"null"},{"type":"string","minLength":1}]},
    "secret_kdf_algorithm_id":{"oneOf":[{"type":"null"},{"type":"string","minLength":1}]},
    "secret_hkdf_algorithm_id":{"oneOf":[{"type":"null"},{"type":"string","minLength":1}]},
    "recovery_secret_type":{"enum":["none","generated-high-entropy","user-chosen-passphrase"]},
    "minimum_generated_secret_bits":{"oneOf":[{"type":"null"},{"type":"integer","minimum":128}]},
    "argon2_version":{"oneOf":[{"type":"null"},{"const":"0x13"}]},
    "argon2_memory_kib":{"oneOf":[{"type":"null"},{"type":"integer","minimum":8192}]},
    "argon2_iterations":{"oneOf":[{"type":"null"},{"type":"integer","minimum":1}]},
    "argon2_parallelism":{"oneOf":[{"type":"null"},{"type":"integer","minimum":1}]},
    "argon2_salt_bytes":{"oneOf":[{"type":"null"},{"type":"integer","minimum":16}]},
    "argon2_output_bytes":{"oneOf":[{"type":"null"},{"type":"integer","minimum":32}]},
    "hardware_assistance":{"type":"boolean"},
    "hardware_wrap_aead_algorithm_id":{"oneOf":[{"type":"null"},{"type":"string","minLength":1}]},
    "hardware_module_assurance":{"enum":["none","fips-140-3-validated","equivalent-evaluated-hsm","platform-secure-hardware"]},
    "require_non_exportable_hardware_key":{"type":"boolean"},
    "require_hardware_attestation":{"type":"boolean"},
    "require_hardware_rate_limiting":{"type":"boolean"},
    "require_authorized_restoring_device":{"const":true},
    "require_manifest_authentication":{"const":true},
    "require_fresh_backup_key_per_generation":{"const":true},
    "require_generation_rollback_protection":{"const":true},
    "allow_server_plaintext":{"const":false},
    "allow_server_unwrapped_backup_key":{"const":false},
    "notes":{"type":"string"}
  }
}
