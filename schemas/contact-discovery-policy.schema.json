{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://e2eesa.example/schemas/contact-discovery-policy.schema.json",
  "title":"E2EESA contact discovery policy",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "schema_version","policy_id","profile_ref","registry_version",
    "normalization_profile_id","discoverability_opt_in_required",
    "return_only_matches","raw_address_book_upload_allowed",
    "raw_identifier_hash_upload_allowed","max_batch_size",
    "max_queries_per_account_per_day","exact_query_required",
    "voprf_required","voprf_suite_id","voprf_public_key_id",
    "directory_epoch_required","directory_snapshot_authentication_required",
    "confidential_compute_required","attestation_required",
    "measurement_allowlist_required","encrypted_channel_to_trusted_boundary_required",
    "host_plaintext_access_allowed","query_persistence_allowed",
    "memory_zeroization_required"
  ],
  "properties":{
    "schema_version":{"const":"0.1"},
    "policy_id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "profile_ref":{"enum":["contact-exact-handle@0.1.0","contact-voprf-directory@0.1.0","contact-attested-private-set@0.1.0"]},
    "registry_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "normalization_profile_id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*@[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "discoverability_opt_in_required":{"const":true},
    "return_only_matches":{"const":true},
    "raw_address_book_upload_allowed":{"const":false},
    "raw_identifier_hash_upload_allowed":{"const":false},
    "max_batch_size":{"type":"integer","minimum":1},
    "max_queries_per_account_per_day":{"type":"integer","minimum":1},
    "exact_query_required":{"type":"boolean"},
    "voprf_required":{"type":"boolean"},
    "voprf_suite_id":{"oneOf":[{"type":"null"},{"type":"string","minLength":1}]},
    "voprf_public_key_id":{"oneOf":[{"type":"null"},{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"}]},
    "directory_epoch_required":{"type":"boolean"},
    "directory_snapshot_authentication_required":{"type":"boolean"},
    "confidential_compute_required":{"type":"boolean"},
    "attestation_required":{"type":"boolean"},
    "measurement_allowlist_required":{"type":"boolean"},
    "encrypted_channel_to_trusted_boundary_required":{"type":"boolean"},
    "host_plaintext_access_allowed":{"const":false},
    "query_persistence_allowed":{"const":false},
    "memory_zeroization_required":{"type":"boolean"},
    "notes":{"type":"string"}
  }
}
