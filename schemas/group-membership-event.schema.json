{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://e2eesa.example/schemas/group-membership-event.schema.json",
  "title":"E2EESA group membership transition evidence",
  "type":"object",
  "additionalProperties":false,
  "$defs":{
    "authorizer":{
      "type":"object","additionalProperties":false,
      "required":["type","id"],
      "properties":{
        "type":{"enum":["device","server"]},
        "id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"}
      }
    }
  },
  "required":[
    "schema_version","event_id","group_id","profile_ref","identity_state_hash",
    "previous_epoch","new_epoch","previous_member_device_ids","added_member_device_ids",
    "removed_member_device_ids","new_member_device_ids","verified_membership_authorizers",
    "membership_transcript_authenticated","future_content_rebound_to_new_membership",
    "added_members_prior_epoch_access","removed_members_new_epoch_access",
    "mls_commit_authenticated","mls_update_path_present","mls_welcome_count",
    "mls_key_packages_single_use","sender_keys_rotated_for_all_active_senders",
    "sender_key_distribution_covers_current_members","pairwise_recipient_set_updated"
  ],
  "properties":{
    "schema_version":{"const":"0.1"},
    "event_id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "group_id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "profile_ref":{"type":"string","minLength":1},
    "identity_state_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "previous_epoch":{"type":"integer","minimum":0},
    "new_epoch":{"type":"integer","minimum":1},
    "previous_member_device_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"}},
    "added_member_device_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"}},
    "removed_member_device_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"}},
    "new_member_device_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"}},
    "verified_membership_authorizers":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/authorizer"}},
    "membership_transcript_authenticated":{"type":"boolean"},
    "future_content_rebound_to_new_membership":{"type":"boolean"},
    "added_members_prior_epoch_access":{"type":"boolean"},
    "removed_members_new_epoch_access":{"type":"boolean"},
    "mls_commit_authenticated":{"type":"boolean"},
    "mls_update_path_present":{"type":"boolean"},
    "mls_welcome_count":{"type":"integer","minimum":0},
    "mls_key_packages_single_use":{"type":"boolean"},
    "sender_keys_rotated_for_all_active_senders":{"type":"boolean"},
    "sender_key_distribution_covers_current_members":{"type":"boolean"},
    "pairwise_recipient_set_updated":{"type":"boolean"}
  }
}
