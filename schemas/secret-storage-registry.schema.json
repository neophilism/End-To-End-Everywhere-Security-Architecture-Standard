{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://e2eesa.example/schemas/secret-storage-registry.schema.json",
  "title":"E2EESA secret-storage mechanism registry",
  "type":"object","additionalProperties":false,
  "required":["schema_version","registry_version","standard_version","mechanisms"],
  "properties":{
    "schema_version":{"const":"0.1"},
    "registry_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "standard_version":{"type":"string","minLength":1},
    "mechanisms":{"type":"array","minItems":1,"items":{
      "type":"object","additionalProperties":false,
      "required":["id","name","class","status","specification","reference_uri","non_exportable_capable","hardware_isolation_capable","attestation_capable","rollback_counter_capable","notes"],
      "properties":{
        "id":{"type":"string","pattern":"^SECRET-[A-Z0-9.-]+$"},
        "name":{"type":"string","minLength":1},
        "class":{"enum":["platform-keystore","hardware-isolated","external-token","software-vault"]},
        "status":{"enum":["recommended","allowed","legacy","deprecated","prohibited","provisional"]},
        "specification":{"type":"string","minLength":1},
        "reference_uri":{"type":"string","pattern":"^https://"},
        "non_exportable_capable":{"type":"boolean"},
        "hardware_isolation_capable":{"type":"boolean"},
        "attestation_capable":{"oneOf":[{"type":"boolean"},{"const":"platform-dependent"},{"const":"token-dependent"}]},
        "rollback_counter_capable":{"oneOf":[{"type":"boolean"},{"const":"platform-dependent"},{"const":"token-dependent"}]},
        "notes":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}
      }
    }}
  }
}
