{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://endtoendeverywhere.org/e2eesa/schemas/assurance-levels-registry.schema.json",
  "title": "E2EESA Assurance Levels Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_version", "levels"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "registry_version": {"type": "string", "minLength": 1},
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile_ref", "ordinal", "name", "minimum_independent_assessors", "required_profile_refs", "symbolic_property_ids", "refinement_property_ids", "computational_property_ids"],
        "properties": {
          "profile_ref": {"type": "string", "pattern": "^assurance-[a-z0-9-]+@[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "ordinal": {"type": "integer", "minimum": 1},
          "name": {"type": "string", "minLength": 1},
          "minimum_independent_assessors": {"type": "integer", "minimum": 1, "maximum": 10},
          "required_profile_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "symbolic_property_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^SP-[A-Z0-9-]+$"}},
          "refinement_property_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^SP-[A-Z0-9-]+$"}},
          "computational_property_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^SP-[A-Z0-9-]+$"}}
        }
      }
    }
  }
}
