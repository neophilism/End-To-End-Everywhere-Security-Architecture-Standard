{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://e2eesa.example/schemas/identity-recovery-event.schema.json",
  "title": "E2EESA identity recovery or replacement event",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "authorizer": {
      "type":"object",
      "additionalProperties":false,
      "required":["type","id","prior_state_hash","resulting_identity_id","observed_history_epoch"],
      "properties":{
        "type":{"enum":["retained-authority","contact","account","server","support"]},
        "id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "prior_state_hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
        "resulting_identity_id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "observed_history_epoch":{"type":"integer","minimum":0}
      }
    }
  },
  "required":["schema_version","event_id","operation","prior_identity_id","prior_state_hash","observed_history_epoch","resulting_identity_id","resulting_state_hash","freshness_proof_id","verified_authorizers","account_delay_elapsed"],
  "properties":{
    "schema_version":{"const":"0.1"},
    "event_id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "operation":{"enum":["recover-identity","create-replacement"]},
    "prior_identity_id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "prior_state_hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "observed_history_epoch":{"type":"integer","minimum":0},
    "resulting_identity_id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "resulting_state_hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "freshness_proof_id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "verified_authorizers":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/authorizer"}},
    "account_delay_elapsed":{"type":"boolean"}
  }
}
