{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://e2eesa.example/schemas/transport-security-registry.schema.json",
  "title":"E2EESA transport security registry",
  "type":"object","additionalProperties":false,
  "required":["schema_version","registry_version","standard_version","tls_protocol","transport_modes","cipher_suites","groups","obsoleted_groups","identity_verification"],
  "properties":{
    "schema_version":{"const":"0.1"},
    "registry_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "standard_version":{"type":"string","minLength":1},
    "tls_protocol":{"type":"object"},
    "transport_modes":{"type":"array","minItems":2},
    "cipher_suites":{"type":"array","minItems":3},
    "groups":{"type":"array","minItems":6},
    "obsoleted_groups":{"type":"array","minItems":2},
    "identity_verification":{"type":"object"}
  }
}
