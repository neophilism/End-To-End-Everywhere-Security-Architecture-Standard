{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://endtoendeverywhere.org/e2eesa/schemas/confidence-classification-policy.schema.json",
  "title":"E2EESA Confidence and Classification Policy",
  "type":"object","additionalProperties":false,
  "required":["schema_version","policy_id","classification_mode","taxonomy","allowed_assessment_confidence_models","final_confidence_model","mixed_resolution","minimum_evidence_citations","max_calibration_age_days","automated_output_must_record_model","human_override_reason_required"],
  "properties":{
    "schema_version":{"const":"0.1"},
    "policy_id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "classification_mode":{"enum":["human-reviewed","automated","mixed"]},
    "taxonomy":{
      "type":"object","additionalProperties":false,
      "required":["taxonomy_id","version","reference"],
      "properties":{
        "taxonomy_id":{"type":"string","minLength":1},
        "version":{"type":"string","minLength":1},
        "reference":{"type":"string","minLength":1}
      }
    },
    "allowed_assessment_confidence_models":{
      "type":"array","minItems":1,"uniqueItems":true,
      "items":{"enum":["dimensional-ordinal","stix-0-100","calibrated-probability"]}
    },
    "final_confidence_model":{"enum":["dimensional-ordinal","stix-0-100","calibrated-probability"]},
    "mixed_resolution":{
      "type":["object","null"],
      "additionalProperties":false,
      "required":["strategy","consensus_confidence_source","human_weight_percent","automated_weight_percent"],
      "properties":{
        "strategy":{"enum":["human-final","consensus","declared-weighted"]},
        "consensus_confidence_source":{"type":["string","null"],"enum":["human","automated",null]},
        "human_weight_percent":{"type":["integer","null"],"minimum":0,"maximum":100},
        "automated_weight_percent":{"type":["integer","null"],"minimum":0,"maximum":100}
      }
    },
    "minimum_evidence_citations":{"type":"integer","minimum":1},
    "max_calibration_age_days":{"type":["integer","null"],"minimum":1,"maximum":3650},
    "automated_output_must_record_model":{"const":true},
    "human_override_reason_required":{"const":true}
  }
}
