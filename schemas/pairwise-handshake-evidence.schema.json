{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://e2eesa.example/schemas/pairwise-handshake-evidence.schema.json",
  "title":"E2EESA pairwise handshake evidence",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "schema_version","session_id","profile_ref","protocol_registry_version",
    "initialization_protocol_id","initiator_device_id","responder_device_id",
    "initiator_identity_key_fingerprint","responder_identity_key_fingerprint",
    "signed_prekey_id","signed_prekey_signature_verified",
    "one_time_prekey_available","one_time_prekey_id","one_time_prekey_consumed",
    "pq_signed_prekey_id","pq_signed_prekey_verified",
    "pq_one_time_prekey_available","pq_one_time_prekey_id","pq_one_time_prekey_consumed",
    "associated_data_binds_identities","initial_ciphertext_authenticated",
    "initial_message_id","replay_status","ratchet_initialized",
    "responder_first_send_randomized"
  ],
  "properties":{
    "schema_version":{"const":"0.1"},
    "session_id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "profile_ref":{"type":"string","minLength":1},
    "protocol_registry_version":{"type":"string","minLength":1},
    "initialization_protocol_id":{"type":"string","pattern":"^PROTO-[A-Z0-9-]+$"},
    "initiator_device_id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "responder_device_id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "initiator_identity_key_fingerprint":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "responder_identity_key_fingerprint":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "signed_prekey_id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "signed_prekey_signature_verified":{"type":"boolean"},
    "one_time_prekey_available":{"type":"boolean"},
    "one_time_prekey_id":{"oneOf":[{"type":"null"},{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"}]},
    "one_time_prekey_consumed":{"type":"boolean"},
    "pq_signed_prekey_id":{"oneOf":[{"type":"null"},{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"}]},
    "pq_signed_prekey_verified":{"type":"boolean"},
    "pq_one_time_prekey_available":{"type":"boolean"},
    "pq_one_time_prekey_id":{"oneOf":[{"type":"null"},{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"}]},
    "pq_one_time_prekey_consumed":{"type":"boolean"},
    "associated_data_binds_identities":{"type":"boolean"},
    "initial_ciphertext_authenticated":{"type":"boolean"},
    "initial_message_id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "replay_status":{"enum":["fresh","replay"]},
    "ratchet_initialized":{"type":"boolean"},
    "responder_first_send_randomized":{"type":"boolean"}
  }
}
