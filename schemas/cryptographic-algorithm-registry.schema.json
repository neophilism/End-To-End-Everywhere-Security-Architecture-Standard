{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://endtoendeverywhere.org/e2eesa/schemas/cryptographic-algorithm-registry.schema.json",
  "title": "E2EESA Cryptographic Algorithm Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_version",
    "standard_version",
    "algorithms",
    "suites"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "registry_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "standard_version": {
      "type": "string",
      "minLength": 1
    },
    "algorithms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "category",
          "status",
          "specification",
          "reference_uri",
          "pq_characteristic",
          "uses",
          "constraints"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ALG-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "enum": [
              "key-agreement",
              "kem",
              "signature",
              "hash",
              "kdf",
              "aead"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "recommended",
              "allowed",
              "provisional",
              "experimental",
              "legacy",
              "deprecated",
              "prohibited"
            ]
          },
          "status_reason": {
            "type": "string",
            "minLength": 1
          },
          "specification": {
            "type": "string",
            "minLength": 1
          },
          "reference_uri": {
            "type": "string",
            "format": "uri"
          },
          "pq_characteristic": {
            "type": "string",
            "enum": [
              "classical",
              "post-quantum",
              "symmetric-or-hash"
            ]
          },
          "uses": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "constraints": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "suites": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "status",
          "protocol",
          "specification",
          "reference_uri",
          "algorithm_ids",
          "constraints",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SUITE-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "recommended",
              "allowed",
              "provisional",
              "experimental",
              "legacy",
              "deprecated",
              "prohibited"
            ]
          },
          "protocol": {
            "type": "string",
            "minLength": 1
          },
          "specification": {
            "type": "string",
            "minLength": 1
          },
          "reference_uri": {
            "type": "string",
            "format": "uri"
          },
          "algorithm_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^ALG-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
            }
          },
          "constraints": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
