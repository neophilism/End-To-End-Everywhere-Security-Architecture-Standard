{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://e2eesa.example/schemas/transport-handshake-evidence.schema.json",
  "title":"E2EESA transport handshake evidence",
  "type":"object","additionalProperties":false,
  "required":[
    "schema_version","connection_id","profile_ref","transport_mode","quic_version",
    "tls_version","offered_group_ids","selected_group_id","selected_cipher_suite",
    "alpn","fresh_key_share_verified","session_resumed","psk_key_exchange_mode",
    "early_data_used","zero_rtt_application_profile_applied",
    "zero_rtt_replay_protection_verified",
    "server_certificate_chain_validated","server_reference_identifier",
    "expected_reference_identifier","reference_identifier_match",
    "common_name_fallback_used","certificate_currently_valid",
    "certificate_signature_algorithm_id","trust_model",
    "client_certificate_requested","client_certificate_present",
    "client_certificate_validated","client_identity_authorized",
    "hybrid_to_classical_fallback_occurred",
    "obsolete_prestandard_kyber_group_used",
    "transport_key_exchange_pq_protected",
    "pq_authentication_claimed_from_transport",
    "application_e2ee_terminated_or_decrypted_by_transport"
  ],
  "properties":{
    "schema_version":{"const":"0.1"},
    "connection_id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "profile_ref":{"enum":["transport-tls13-classical@0.1.0","transport-tls13-hybrid@0.1.0"]},
    "transport_mode":{"enum":["tls-stream","quic"]},
    "quic_version":{"oneOf":[{"type":"null"},{"enum":["v1","v2"]}]},
    "tls_version":{"type":"string","minLength":1},
    "offered_group_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "selected_group_id":{"type":"string","minLength":1},
    "selected_cipher_suite":{"type":"string","minLength":1},
    "alpn":{"type":"string","minLength":1},
    "fresh_key_share_verified":{"type":"boolean"},
    "session_resumed":{"type":"boolean"},
    "psk_key_exchange_mode":{"enum":["none","psk_dhe_ke","psk_ke"]},
    "early_data_used":{"type":"boolean"},
    "zero_rtt_application_profile_applied":{"type":"boolean"},
    "zero_rtt_replay_protection_verified":{"type":"boolean"},
    "server_certificate_chain_validated":{"type":"boolean"},
    "server_reference_identifier":{"type":"string","minLength":1},
    "expected_reference_identifier":{"type":"string","minLength":1},
    "reference_identifier_match":{"type":"boolean"},
    "common_name_fallback_used":{"type":"boolean"},
    "certificate_currently_valid":{"type":"boolean"},
    "certificate_signature_algorithm_id":{"type":"string","minLength":1},
    "trust_model":{"enum":["public-web-pki","private-pki"]},
    "client_certificate_requested":{"type":"boolean"},
    "client_certificate_present":{"type":"boolean"},
    "client_certificate_validated":{"type":"boolean"},
    "client_identity_authorized":{"type":"boolean"},
    "hybrid_to_classical_fallback_occurred":{"type":"boolean"},
    "obsolete_prestandard_kyber_group_used":{"type":"boolean"},
    "transport_key_exchange_pq_protected":{"type":"boolean"},
    "pq_authentication_claimed_from_transport":{"type":"boolean"},
    "application_e2ee_terminated_or_decrypted_by_transport":{"type":"boolean"}
  }
}
