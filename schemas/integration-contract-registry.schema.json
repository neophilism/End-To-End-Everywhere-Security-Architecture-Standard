{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://endtoendeverywhere.org/e2eesa/schemas/integration-contract-registry.schema.json",
  "type":"object","additionalProperties":false,
  "required":["schema_version","registry_version","standard_version","systems","artifact_types","contracts"],
  "properties":{
    "schema_version":{"const":"0.1"},
    "registry_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "standard_version":{"type":"string","minLength":1},
    "systems":{"type":"array","minItems":7,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "artifact_types":{"type":"array","minItems":1,"items":{
      "type":"object","additionalProperties":false,
      "required":["artifact_type","authority_path","schema_path","artifact_class","binding_fields","mutability"],
      "properties":{
        "artifact_type":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "authority_path":{"type":["string","null"]},
        "schema_path":{"type":["string","null"]},
        "artifact_class":{"enum":["normative","request","result","evidence","state","projection"]},
        "binding_fields":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
        "mutability":{"enum":["preserve","produce-new","derive"]}
      }
    }},
    "contracts":{"type":"array","minItems":6,"items":{
      "type":"object","additionalProperties":false,
      "required":["contract_id","contract_version","system_id","consumes","emits"],
      "properties":{
        "contract_id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "contract_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "system_id":{"type":"string","minLength":1},
        "consumes":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
        "emits":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}
      }
    }}
  }
}
