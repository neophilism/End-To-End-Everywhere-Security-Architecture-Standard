{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://endtoendeverywhere.org/e2eesa/schemas/release-manifest.schema.json",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","release_version","basis_standard_version","file_count","files","tree_digest"],
  "properties":{
    "schema_version":{"const":"0.1"},
    "release_version":{"type":"string","minLength":1},
    "basis_standard_version":{"type":"string","minLength":1},
    "file_count":{"type":"integer","minimum":1},
    "files":{"type":"array","minItems":1,"items":{
      "type":"object","additionalProperties":false,
      "required":["path","size","git_blob_sha"],
      "properties":{
        "path":{"type":"string","minLength":1},
        "size":{"type":"integer","minimum":0},
        "git_blob_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"}
      }
    }},
    "tree_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  }
}
