{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://e2eesa.example/schemas/contact-discovery-evidence.schema.json",
  "title":"E2EESA contact discovery evidence",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "schema_version","event_id","profile_ref","query_count",
    "normalized_identifier_count","discoverability_policy_enforced",
    "raw_address_book_sent_to_service","raw_identifier_hashes_sent_to_service",
    "only_matching_registered_entries_returned",
    "service_observed_query_identifiers","service_observed_query_outputs",
    "exact_user_supplied_query","voprf_blinded_inputs_verified",
    "voprf_proof_verified","voprf_public_key_id","directory_epoch",
    "directory_snapshot_authenticated","directory_snapshot_version",
    "online_query_budget_enforced","confidential_compute_used",
    "attestation_verified","measurement_authorized",
    "encrypted_channel_terminated_inside_trusted_boundary",
    "host_observed_plaintext_identifiers","query_persisted_after_completion",
    "query_memory_zeroized","result_count"
  ],
  "properties":{
    "schema_version":{"const":"0.1"},
    "event_id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "profile_ref":{"enum":["contact-exact-handle@0.1.0","contact-voprf-directory@0.1.0","contact-attested-private-set@0.1.0"]},
    "query_count":{"type":"integer","minimum":1},
    "normalized_identifier_count":{"type":"integer","minimum":1},
    "discoverability_policy_enforced":{"type":"boolean"},
    "raw_address_book_sent_to_service":{"type":"boolean"},
    "raw_identifier_hashes_sent_to_service":{"type":"boolean"},
    "only_matching_registered_entries_returned":{"type":"boolean"},
    "service_observed_query_identifiers":{"type":"boolean"},
    "service_observed_query_outputs":{"type":"boolean"},
    "exact_user_supplied_query":{"type":"boolean"},
    "voprf_blinded_inputs_verified":{"type":"boolean"},
    "voprf_proof_verified":{"type":"boolean"},
    "voprf_public_key_id":{"oneOf":[{"type":"null"},{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"}]},
    "directory_epoch":{"oneOf":[{"type":"null"},{"type":"integer","minimum":1}]},
    "directory_snapshot_authenticated":{"type":"boolean"},
    "directory_snapshot_version":{"oneOf":[{"type":"null"},{"type":"integer","minimum":1}]},
    "online_query_budget_enforced":{"type":"boolean"},
    "confidential_compute_used":{"type":"boolean"},
    "attestation_verified":{"type":"boolean"},
    "measurement_authorized":{"type":"boolean"},
    "encrypted_channel_terminated_inside_trusted_boundary":{"type":"boolean"},
    "host_observed_plaintext_identifiers":{"type":"boolean"},
    "query_persisted_after_completion":{"type":"boolean"},
    "query_memory_zeroized":{"type":"boolean"},
    "result_count":{"type":"integer","minimum":0}
  }
}
