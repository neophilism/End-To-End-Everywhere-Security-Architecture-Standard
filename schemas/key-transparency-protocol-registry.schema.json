{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://e2eesa.example/schemas/key-transparency-protocol-registry.schema.json",
  "title":"E2EESA key transparency protocol registry",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","registry_version","standard_version","protocols","cipher_suites"],
  "properties":{
    "schema_version":{"const":"0.1"},
    "registry_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "standard_version":{"type":"string","minLength":1},
    "protocols":{"type":"array","minItems":1,"items":{
      "type":"object","additionalProperties":false,
      "required":["id","name","status","specification","published_or_updated","reference_uri","architecture_specification","architecture_reference_uri","notes"],
      "properties":{
        "id":{"type":"string","pattern":"^KEYTRANS-[A-Z0-9-]+$"},
        "name":{"type":"string","minLength":1},
        "status":{"enum":["recommended","allowed","provisional","experimental","legacy","deprecated","prohibited"]},
        "specification":{"type":"string","minLength":1},
        "published_or_updated":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "reference_uri":{"type":"string","pattern":"^https://"},
        "architecture_specification":{"type":"string","minLength":1},
        "architecture_reference_uri":{"type":"string","pattern":"^https://"},
        "notes":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}
      }
    }},
    "cipher_suites":{"type":"array","minItems":1,"items":{
      "type":"object","additionalProperties":false,
      "required":["id","name","status","hash","signature","vrf","reference_uri"],
      "properties":{
        "id":{"type":"string","pattern":"^0x[0-9A-Fa-f]{4}$"},
        "name":{"type":"string","minLength":1},
        "status":{"enum":["recommended","allowed","provisional","experimental","legacy","deprecated","prohibited"]},
        "hash":{"type":"string","minLength":1},
        "signature":{"type":"string","minLength":1},
        "vrf":{"type":"string","minLength":1},
        "reference_uri":{"type":"string","pattern":"^https://"}
      }
    }}
  }
}
