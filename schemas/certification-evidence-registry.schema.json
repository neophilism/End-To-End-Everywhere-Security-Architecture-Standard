{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://endtoendeverywhere.org/e2eesa/schemas/certification-evidence-registry.schema.json",
  "title":"E2EESA Certification Evidence Registry",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","registry_version","evidence_types","assurance_requirements"],
  "properties":{
    "schema_version":{"const":"0.1"},
    "registry_version":{"type":"string","minLength":1},
    "evidence_types":{
      "type":"array","minItems":1,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["type","independence_required"],
        "properties":{
          "type":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "independence_required":{"type":"boolean"}
        }
      }
    },
    "assurance_requirements":{
      "type":"array","minItems":1,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["assurance_profile_ref","required_evidence_types","minimum_source_access"],
        "properties":{
          "assurance_profile_ref":{"type":"string","pattern":"^assurance-[a-z0-9-]+@[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "required_evidence_types":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"}},
          "minimum_source_access":{"enum":["none","restricted-review","escrowed-source","full-source"]}
        }
      }
    }
  }
}
