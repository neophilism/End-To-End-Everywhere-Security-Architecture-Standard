{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"https://e2eesa.example/schemas/secret-storage-key-event.schema.json",
 "title":"E2EESA secret-storage key lifecycle evidence",
 "type":"object","additionalProperties":false,
 "required":[
  "schema_version","event_id","profile_ref","mechanism_id","device_id",
  "event_type","old_key_id","new_key_id","new_key_non_exportable",
  "new_key_hardware_isolated","old_key_invalidated","auth_policy_changed",
  "vault_rewrapped_under_new_key","remote_copy_of_raw_root_key_exists"
 ],
 "properties":{
  "schema_version":{"const":"0.1"},
  "event_id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
  "profile_ref":{"enum":["secret-platform-keystore@0.1.0","secret-hardware-isolated@0.1.0","secret-external-token@0.1.0","secret-software-vault@0.1.0"]},
  "mechanism_id":{"type":"string","pattern":"^SECRET-[A-Z0-9.-]+$"},
  "device_id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
  "event_type":{"enum":["create","rotate","invalidate","delete"]},
  "old_key_id":{"oneOf":[{"type":"null"},{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"}]},
  "new_key_id":{"oneOf":[{"type":"null"},{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"}]},
  "new_key_non_exportable":{"type":"boolean"},
  "new_key_hardware_isolated":{"type":"boolean"},
  "old_key_invalidated":{"type":"boolean"},
  "auth_policy_changed":{"type":"boolean"},
  "vault_rewrapped_under_new_key":{"type":"boolean"},
  "remote_copy_of_raw_root_key_exists":{"type":"boolean"}
 }
}
