{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://endtoendeverywhere.org/e2eesa/schemas/release-candidate.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_version",
    "basis_standard_version",
    "manifest_path",
    "frozen_roots",
    "frozen_top_level_files",
    "excluded_paths",
    "required_release_gates"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "release_version": {
      "const": "0.9.0-rc.1"
    },
    "basis_standard_version": {
      "type": "string",
      "minLength": 1
    },
    "manifest_path": {
      "const": "release/0.9.0-rc.1-manifest.json"
    },
    "frozen_roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "frozen_top_level_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "excluded_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_release_gates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "development_state": {
      "enum": [
        "audit-remediation",
        "frozen-candidate"
      ]
    },
    "historical_candidates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  }
}
