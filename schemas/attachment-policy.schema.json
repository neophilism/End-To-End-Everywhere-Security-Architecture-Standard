{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://e2eesa.example/schemas/attachment-policy.schema.json",
  "title":"E2EESA attachment encryption policy",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "schema_version","policy_id","profile_ref",
    "content_aead_algorithm_id","hash_algorithm_id",
    "attachment_key_bits","chunk_size_bytes","maximum_chunk_count",
    "nonce_prefix_bytes","nonce_counter_bytes",
    "require_fresh_attachment_key","require_e2ee_manifest_delivery",
    "require_manifest_authentication","require_chunk_aad_binding",
    "require_authorized_key_distribution","allow_key_in_url",
    "allow_key_in_storage_metadata","allow_server_plaintext",
    "allow_server_attachment_key","require_delete_api",
    "require_orphan_cleanup","require_no_global_recall_claim"
  ],
  "properties":{
    "schema_version":{"const":"0.1"},
    "policy_id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "profile_ref":{"const":"attachment-chunked-aead@0.1.0"},
    "content_aead_algorithm_id":{"enum":["ALG-AES-256-GCM","ALG-CHACHA20-POLY1305","ALG-AES-256-GCM-SIV"]},
    "hash_algorithm_id":{"enum":["ALG-SHA256","ALG-SHA384","ALG-SHA512","ALG-SHA3-256","ALG-SHA3-384","ALG-SHA3-512"]},
    "attachment_key_bits":{"const":256},
    "chunk_size_bytes":{"type":"integer","minimum":65536,"maximum":8388608},
    "maximum_chunk_count":{"type":"integer","minimum":1,"maximum":4294967295},
    "nonce_prefix_bytes":{"const":4},
    "nonce_counter_bytes":{"const":8},
    "require_fresh_attachment_key":{"const":true},
    "require_e2ee_manifest_delivery":{"const":true},
    "require_manifest_authentication":{"const":true},
    "require_chunk_aad_binding":{"const":true},
    "require_authorized_key_distribution":{"const":true},
    "allow_key_in_url":{"const":false},
    "allow_key_in_storage_metadata":{"const":false},
    "allow_server_plaintext":{"const":false},
    "allow_server_attachment_key":{"const":false},
    "require_delete_api":{"const":true},
    "require_orphan_cleanup":{"const":true},
    "require_no_global_recall_claim":{"const":true},
    "notes":{"type":"string"}
  }
}
