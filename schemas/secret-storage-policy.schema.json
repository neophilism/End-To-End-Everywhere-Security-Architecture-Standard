{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"https://e2eesa.example/schemas/secret-storage-policy.schema.json",
 "title":"E2EESA secret-storage policy",
 "type":"object","additionalProperties":false,
 "required":[
  "schema_version","policy_id","profile_ref","registry_version","mechanism_id",
  "vault_aead_algorithm_id","vault_key_bits","require_non_exportable_root_key",
  "require_hardware_isolation","require_attestation","require_key_use_authorization",
  "require_user_authentication","require_user_presence","rollback_anchor_mode",
  "require_rollback_protection","software_secret_type","software_kdf_algorithm_id",
  "minimum_generated_secret_bits","argon2_version","argon2_memory_kib",
  "argon2_iterations","argon2_parallelism","argon2_salt_bytes","argon2_output_bytes",
  "allow_plaintext_secret_at_rest","allow_root_key_export","allow_raw_root_key_cloud_sync",
  "require_key_rotation_on_auth_change","require_vault_generation_monotonicity"
 ],
 "properties":{
  "schema_version":{"const":"0.1"},
  "policy_id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
  "profile_ref":{"enum":["secret-platform-keystore@0.1.0","secret-hardware-isolated@0.1.0","secret-external-token@0.1.0","secret-software-vault@0.1.0"]},
  "registry_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
  "mechanism_id":{"type":"string","pattern":"^SECRET-[A-Z0-9.-]+$"},
  "vault_aead_algorithm_id":{"enum":["ALG-AES-256-GCM","ALG-CHACHA20-POLY1305","ALG-AES-256-GCM-SIV"]},
  "vault_key_bits":{"const":256},
  "require_non_exportable_root_key":{"type":"boolean"},
  "require_hardware_isolation":{"type":"boolean"},
  "require_attestation":{"type":"boolean"},
  "require_key_use_authorization":{"const":true},
  "require_user_authentication":{"type":"boolean"},
  "require_user_presence":{"type":"boolean"},
  "rollback_anchor_mode":{"enum":["none","hardware-monotonic","independent-witness"]},
  "require_rollback_protection":{"type":"boolean"},
  "software_secret_type":{"enum":["none","generated-high-entropy","user-passphrase"]},
  "software_kdf_algorithm_id":{"oneOf":[{"type":"null"},{"const":"ALG-ARGON2ID"}]},
  "minimum_generated_secret_bits":{"oneOf":[{"type":"null"},{"type":"integer","minimum":128}]},
  "argon2_version":{"oneOf":[{"type":"null"},{"const":"0x13"}]},
  "argon2_memory_kib":{"oneOf":[{"type":"null"},{"type":"integer","minimum":8192}]},
  "argon2_iterations":{"oneOf":[{"type":"null"},{"type":"integer","minimum":1}]},
  "argon2_parallelism":{"oneOf":[{"type":"null"},{"type":"integer","minimum":1}]},
  "argon2_salt_bytes":{"oneOf":[{"type":"null"},{"type":"integer","minimum":16}]},
  "argon2_output_bytes":{"oneOf":[{"type":"null"},{"type":"integer","minimum":32}]},
  "allow_plaintext_secret_at_rest":{"const":false},
  "allow_root_key_export":{"const":false},
  "allow_raw_root_key_cloud_sync":{"const":false},
  "require_key_rotation_on_auth_change":{"const":true},
  "require_vault_generation_monotonicity":{"const":true},
  "notes":{"type":"string"}
 }
}
