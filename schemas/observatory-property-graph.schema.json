{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://endtoendeverywhere.org/e2eesa/schemas/observatory-property-graph.schema.json",
  "title":"E2EESA Observatory Property Graph Projection",
  "type":"object","additionalProperties":false,
  "required":["schema_version","projection_version","source_bundle_digest","nodes","edges"],
  "properties":{
    "schema_version":{"const":"0.1"},
    "projection_version":{"const":"0.1.0"},
    "source_bundle_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "nodes":{
      "type":"array",
      "items":{
        "type":"object","additionalProperties":false,
        "required":["node_id","node_type","source_id","properties"],
        "properties":{
          "node_id":{"type":"string","minLength":1},
          "node_type":{"enum":["Bundle","Agent","Entity","Activity","Event","Citation","IntegrityAnchor"]},
          "source_id":{"type":"string","minLength":1},
          "properties":{
            "type":"array","uniqueItems":true,
            "items":{
              "type":"object","additionalProperties":false,
              "required":["name","value"],
              "properties":{
                "name":{"type":"string","minLength":1},
                "value":{"type":["string","integer","boolean","null"]}
              }
            }
          }
        }
      }
    },
    "edges":{
      "type":"array",
      "items":{
        "type":"object","additionalProperties":false,
        "required":["edge_id","edge_type","from_node_id","to_node_id"],
        "properties":{
          "edge_id":{"type":"string","minLength":1},
          "edge_type":{"enum":["CONTAINS","PREVIOUS_BUNDLE","USED","WAS_GENERATED_BY","WAS_ASSOCIATED_WITH","WAS_DERIVED_FROM","CITES","CITATION_SOURCE","HAS_SUBJECT","ANCHORS"]},
          "from_node_id":{"type":"string","minLength":1},
          "to_node_id":{"type":"string","minLength":1}
        }
      }
    }
  }
}
