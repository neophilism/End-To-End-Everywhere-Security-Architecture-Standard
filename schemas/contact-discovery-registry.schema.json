{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://e2eesa.example/schemas/contact-discovery-registry.schema.json",
  "title":"E2EESA contact discovery mechanism registry",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","registry_version","standard_version","mechanisms","voprf_suites"],
  "properties":{
    "schema_version":{"const":"0.1"},
    "registry_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "standard_version":{"type":"string","minLength":1},
    "mechanisms":{"type":"array","minItems":1,"items":{
      "type":"object","additionalProperties":false,
      "required":["id","name","status","mechanism_type","specification","reference_uri","notes"],
      "properties":{
        "id":{"type":"string","pattern":"^CONTACT-[A-Z0-9-]+$"},
        "name":{"type":"string","minLength":1},
        "status":{"enum":["recommended","allowed","provisional","experimental","legacy","deprecated","prohibited"]},
        "mechanism_type":{"enum":["exact-handle","voprf-membership","confidential-compute"]},
        "specification":{"type":"string","minLength":1},
        "reference_uri":{"type":"string","pattern":"^https://"},
        "notes":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}
      }
    }},
    "voprf_suites":{"type":"array","minItems":1,"items":{
      "type":"object","additionalProperties":false,
      "required":["id","mode","mode_value","ciphersuite_identifier","status","specification","reference_uri"],
      "properties":{
        "id":{"type":"string","pattern":"^VOPRF-[A-Z0-9-]+$"},
        "mode":{"const":"VOPRF"},
        "mode_value":{"const":"0x01"},
        "ciphersuite_identifier":{"type":"string","minLength":1},
        "status":{"enum":["recommended","allowed","provisional","experimental","legacy","deprecated","prohibited"]},
        "specification":{"type":"string","minLength":1},
        "reference_uri":{"type":"string","pattern":"^https://"}
      }
    }}
  }
}
