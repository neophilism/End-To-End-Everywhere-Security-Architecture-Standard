{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://endtoendeverywhere.org/e2eesa/schemas/conformance-cli-registry.schema.json",
  "title":"E2EESA Conformance CLI Registry",
  "type":"object","additionalProperties":false,
  "required":["schema_version","registry_version","commands","formats","exit_codes"],
  "properties":{
    "schema_version":{"const":"0.1"},
    "registry_version":{"type":"string","minLength":1},
    "commands":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "formats":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["json","text"]}},
    "exit_codes":{
      "type":"array","minItems":1,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["code","name","meaning"],
        "properties":{
          "code":{"type":"integer","minimum":0,"maximum":255},
          "name":{"type":"string","pattern":"^[A-Z][A-Z0-9_]*$"},
          "meaning":{"type":"string","minLength":1}
        }
      }
    }
  }
}
