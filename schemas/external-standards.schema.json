{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"https://endtoendeverywhere.org/e2eesa/schemas/external-standards.schema.json",
 "type":"object","additionalProperties":false,
 "required":["schema_version","registry_version","standards"],
 "properties":{
  "schema_version":{"const":"0.1"},
  "registry_version":{"type":"string","minLength":1},
  "standards":{"type":"array","minItems":1,"items":{
   "type":"object","additionalProperties":false,
   "required":["id","organization","designation","title","status","reference_uri"],
   "properties":{
    "id":{"type":"string","pattern":"^[A-Z0-9]+(?:[-.][A-Za-z0-9]+)*$"},
    "organization":{"type":"string","minLength":1},
    "designation":{"type":"string","minLength":1},
    "title":{"type":"string","minLength":1},
    "status":{"type":"string","minLength":1},
    "reference_uri":{"type":"string","pattern":"^https://"}
   }
  }}
 }
}
