{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://e2eesa.example/schemas/endpoint-egress-policy.schema.json",
  "title": "E2EESA AUD-10 endpoint export policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "flows"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "policy_id": {
      "$ref": "#/$defs/id"
    },
    "flows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/flow"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "profile": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*@[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "metadata": {
      "type": "string",
      "enum": [
        "ciphertext-size",
        "packet-count",
        "delivery-time",
        "routing-token",
        "encrypted-content-length"
      ]
    },
    "derived": {
      "type": "string",
      "enum": [
        "plaintext",
        "classifier",
        "embedding",
        "content-hash",
        "preview",
        "search-index",
        "diagnostic",
        "telemetry",
        "provider-api-call"
      ]
    },
    "ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flow_id",
        "source_class",
        "e2ee_profile_ref",
        "endpoint_recipients",
        "metadata_exposures",
        "explicit_disclosures",
        "public_destinations"
      ],
      "properties": {
        "flow_id": {
          "$ref": "#/$defs/id"
        },
        "source_class": {
          "enum": [
            "public",
            "protected"
          ]
        },
        "e2ee_profile_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/profile"
            }
          ]
        },
        "endpoint_recipients": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/endpoint"
          }
        },
        "metadata_exposures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/exposure"
          }
        },
        "explicit_disclosures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/disclosure"
          }
        },
        "public_destinations": {
          "$ref": "#/$defs/ids"
        }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipient_id",
        "key_fingerprint"
      ],
      "properties": {
        "recipient_id": {
          "$ref": "#/$defs/id"
        },
        "key_fingerprint": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "exposure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "destination_id",
        "permitted_fields"
      ],
      "properties": {
        "destination_id": {
          "$ref": "#/$defs/id"
        },
        "permitted_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/metadata"
          }
        }
      }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization_id",
        "purpose_id",
        "selected_content_ids",
        "recipient_ids",
        "output_kinds",
        "expires_at_epoch"
      ],
      "properties": {
        "authorization_id": {
          "$ref": "#/$defs/id"
        },
        "purpose_id": {
          "$ref": "#/$defs/id"
        },
        "selected_content_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1
        },
        "recipient_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1
        },
        "output_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/derived"
          }
        },
        "expires_at_epoch": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
