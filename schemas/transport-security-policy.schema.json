{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://e2eesa.example/schemas/transport-security-policy.schema.json",
  "title":"E2EESA transport security policy",
  "type":"object","additionalProperties":false,
  "required":[
    "schema_version","policy_id","profile_ref","registry_version",
    "transport_mode","quic_version","minimum_tls_version","maximum_tls_version",
    "allowed_group_ids","preferred_group_id","require_hybrid_group",
    "allowed_cipher_suites","preferred_cipher_suite",
    "authentication_mode","trust_model","service_identity_verification",
    "require_certificate_chain_validation","require_reference_identifier_match",
    "require_fresh_key_share","require_ephemeral_key_exchange_on_resumption",
    "require_alpn","allowed_alpns","allow_0rtt",
    "zero_rtt_application_profile","zero_rtt_replay_protection_required",
    "require_fail_closed_on_transport_downgrade",
    "require_fail_closed_on_hybrid_downgrade",
    "require_no_common_name_fallback","require_e2ee_layer_independence"
  ],
  "properties":{
    "schema_version":{"const":"0.1"},
    "policy_id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "profile_ref":{"enum":["transport-tls13-classical@0.1.0","transport-tls13-hybrid@0.1.0"]},
    "registry_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "transport_mode":{"enum":["tls-stream","quic"]},
    "quic_version":{"oneOf":[{"type":"null"},{"enum":["v1","v2"]}]},
    "minimum_tls_version":{"const":"TLS1.3"},
    "maximum_tls_version":{"const":"TLS1.3"},
    "allowed_group_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "preferred_group_id":{"type":"string","minLength":1},
    "require_hybrid_group":{"type":"boolean"},
    "allowed_cipher_suites":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["TLS_AES_128_GCM_SHA256","TLS_AES_256_GCM_SHA384","TLS_CHACHA20_POLY1305_SHA256"]}},
    "preferred_cipher_suite":{"enum":["TLS_AES_128_GCM_SHA256","TLS_AES_256_GCM_SHA384","TLS_CHACHA20_POLY1305_SHA256"]},
    "authentication_mode":{"enum":["server-certificate","mutual-certificate"]},
    "trust_model":{"enum":["public-web-pki","private-pki"]},
    "service_identity_verification":{"const":"RFC9525"},
    "require_certificate_chain_validation":{"const":true},
    "require_reference_identifier_match":{"const":true},
    "require_fresh_key_share":{"const":true},
    "require_ephemeral_key_exchange_on_resumption":{"const":true},
    "require_alpn":{"const":true},
    "allowed_alpns":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":64}},
    "allow_0rtt":{"type":"boolean"},
    "zero_rtt_application_profile":{"oneOf":[{"type":"null"},{"type":"string","minLength":1}]},
    "zero_rtt_replay_protection_required":{"type":"boolean"},
    "require_fail_closed_on_transport_downgrade":{"const":true},
    "require_fail_closed_on_hybrid_downgrade":{"type":"boolean"},
    "require_no_common_name_fallback":{"const":true},
    "require_e2ee_layer_independence":{"const":true},
    "notes":{"type":"string"}
  }
}
