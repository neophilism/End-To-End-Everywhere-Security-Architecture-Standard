{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://endtoendeverywhere.org/e2eesa/schemas/component-inventory.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product_id",
    "source_digest",
    "artifact_digest",
    "components",
    "flows",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "product_id": {
      "type": "string",
      "minLength": 1
    },
    "source_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "artifact_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component_id",
          "product_class",
          "capabilities",
          "profile_refs",
          "inventory_flow_ids",
          "host_obligations"
        ],
        "properties": {
          "component_id": {
            "type": "string"
          },
          "product_class": {
            "type": "string"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "profile_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "inventory_flow_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "host_obligations": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "flow_id",
          "component_id",
          "operation",
          "data_class",
          "recipient_ids",
          "key_authority_ids",
          "profile_refs",
          "networked"
        ],
        "properties": {
          "flow_id": {
            "type": "string"
          },
          "component_id": {
            "type": "string"
          },
          "operation": {
            "enum": [
              "direct-message",
              "group-message",
              "attachment",
              "media",
              "backup",
              "local-storage",
              "public-data",
              "business-processing"
            ]
          },
          "data_class": {
            "enum": [
              "protected",
              "public",
              "intentionally-disclosed"
            ]
          },
          "recipient_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "key_authority_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "profile_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "networked": {
            "type": "boolean"
          }
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
