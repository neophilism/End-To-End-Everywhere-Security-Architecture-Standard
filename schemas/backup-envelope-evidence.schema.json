{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://e2eesa.example/schemas/backup-envelope-evidence.schema.json",
  "title":"E2EESA encrypted backup envelope evidence",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "schema_version","backup_id","identity_id","profile_ref","generation",
    "content_aead_algorithm_id","backup_data_key_id","backup_data_key_random_bits",
    "backup_data_key_reused","manifest_digest","manifest_authenticated",
    "manifest_binds_identity_and_generation","ciphertext_chunk_count",
    "server_plaintext_access","server_unwrapped_backup_key_access",
    "recovery_secret_uploaded_to_server","secret_kdf_algorithm_id",
    "secret_hkdf_algorithm_id","argon2_salt_hex","argon2_version",
    "argon2_memory_kib","argon2_iterations","argon2_parallelism","argon2_output_bytes",
    "inner_wrapped_backup_key_present","hardware_outer_wrap_present",
    "hardware_wrap_aead_algorithm_id","hardware_key_non_exportable",
    "hardware_attestation_verified"
  ],
  "properties":{
    "schema_version":{"const":"0.1"},
    "backup_id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "identity_id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "profile_ref":{"enum":["backup-user-secret@0.1.0","backup-hardware-assisted@0.1.0"]},
    "generation":{"type":"integer","minimum":1},
    "content_aead_algorithm_id":{"type":"string","minLength":1},
    "backup_data_key_id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "backup_data_key_random_bits":{"type":"integer","minimum":256},
    "backup_data_key_reused":{"type":"boolean"},
    "manifest_digest":{"type":"string","pattern":"^[0-9a-f]{64,128}$"},
    "manifest_authenticated":{"type":"boolean"},
    "manifest_binds_identity_and_generation":{"type":"boolean"},
    "ciphertext_chunk_count":{"type":"integer","minimum":1},
    "server_plaintext_access":{"type":"boolean"},
    "server_unwrapped_backup_key_access":{"type":"boolean"},
    "recovery_secret_uploaded_to_server":{"type":"boolean"},
    "secret_kdf_algorithm_id":{"type":"string","minLength":1},
    "secret_hkdf_algorithm_id":{"type":"string","minLength":1},
    "argon2_salt_hex":{"type":"string","pattern":"^[0-9a-f]{32,}$"},
    "argon2_version":{"const":"0x13"},
    "argon2_memory_kib":{"type":"integer","minimum":8192},
    "argon2_iterations":{"type":"integer","minimum":1},
    "argon2_parallelism":{"type":"integer","minimum":1},
    "argon2_output_bytes":{"type":"integer","minimum":32},
    "inner_wrapped_backup_key_present":{"type":"boolean"},
    "hardware_outer_wrap_present":{"type":"boolean"},
    "hardware_wrap_aead_algorithm_id":{"oneOf":[{"type":"null"},{"type":"string","minLength":1}]},
    "hardware_key_non_exportable":{"type":"boolean"},
    "hardware_attestation_verified":{"type":"boolean"}
  }
}
