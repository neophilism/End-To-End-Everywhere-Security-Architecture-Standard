{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://endtoendeverywhere.org/e2eesa/schemas/compatibility-solver-result.schema.json",
  "title":"E2EESA Compatibility Solver Result",
  "type":"object","additionalProperties":false,
  "required":[
    "schema_version","request_id","request_digest","status","mode","standard_version",
    "search_exhaustive","search_states_examined","total_solution_count",
    "returned_solution_count","truncated","input_digests","solutions",
    "diagnostics","result_digest"
  ],
  "properties":{
    "schema_version":{"const":"0.1"},
    "request_id":{"type":"string","minLength":1},
    "request_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "status":{"enum":["solutions","unsatisfiable","invalid-request","search-limit"]},
    "mode":{"enum":["production","candidate","migration"]},
    "standard_version":{"type":"string","minLength":1},
    "search_exhaustive":{"type":"boolean"},
    "search_states_examined":{"type":"integer","minimum":0},
    "total_solution_count":{"type":["integer","null"],"minimum":0},
    "returned_solution_count":{"type":"integer","minimum":0},
    "truncated":{"type":"boolean"},
    "input_digests":{
      "type":"object","additionalProperties":false,
      "required":[
        "profile_catalog","security_properties_registry",
        "research_promotion_registry","conformance_registry",
        "compatibility_solver_registry"
      ],
      "properties":{
        "profile_catalog":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
        "security_properties_registry":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
        "research_promotion_registry":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
        "conformance_registry":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
        "compatibility_solver_registry":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
      }
    },
    "solutions":{
      "type":"array",
      "items":{
        "type":"object","additionalProperties":false,
        "required":[
          "solution_id","configuration","effective_profile_refs",
          "auto_added_profile_refs","effective_property_ids",
          "in_scope_family_ids","auto_added_family_ids","solution_digest"
        ],
        "properties":{
          "solution_id":{"type":"string","pattern":"^solution-[0-9a-f]{16}$"},
          "configuration":{"$ref":"configuration.schema.json"},
          "effective_profile_refs":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
          "auto_added_profile_refs":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
          "effective_property_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^SP-[A-Z0-9-]+$"}},
          "in_scope_family_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
          "auto_added_family_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
          "solution_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "diagnostics":{
      "type":"array",
      "items":{
        "type":"object","additionalProperties":false,
        "required":["code","severity","message"],
        "properties":{
          "code":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "severity":{"enum":["error","info"]},
          "message":{"type":"string","minLength":1}
        }
      }
    },
    "result_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  }
}
