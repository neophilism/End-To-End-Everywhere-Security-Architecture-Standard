{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://endtoendeverywhere.org/e2eesa/schemas/compatibility-solver-registry.schema.json",
  "title":"E2EESA Compatibility Solver Registry",
  "type":"object","additionalProperties":false,
  "required":["schema_version","registry_version","modes","result_statuses","default_max_solutions","maximum_max_solutions","maximum_search_states"],
  "properties":{
    "schema_version":{"const":"0.1"},
    "registry_version":{"type":"string","minLength":1},
    "modes":{
      "type":"array","minItems":3,"maxItems":3,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["id","eligible_statuses","accepted_nondefault_statuses"],
        "properties":{
          "id":{"enum":["production","candidate","migration"]},
          "eligible_statuses":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
          "accepted_nondefault_statuses":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}
        }
      }
    },
    "result_statuses":{
      "type":"array","uniqueItems":true,
      "items":{"enum":["solutions","unsatisfiable","invalid-request","search-limit"]}
    },
    "default_max_solutions":{"type":"integer","minimum":1},
    "maximum_max_solutions":{"type":"integer","minimum":1},
    "maximum_search_states":{"type":"integer","minimum":1}
  }
}
