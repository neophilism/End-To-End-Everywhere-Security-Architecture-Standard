{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://endtoendeverywhere.org/e2eesa/schemas/advisory-interoperability-registry.schema.json",
  "title":"E2EESA Advisory Interoperability Registry",
  "type":"object","additionalProperties":false,
  "required":["schema_version","registry_version","profiles","current_cve_record_format","current_epss_model","epss_v5_effective_date"],
  "properties":{
    "schema_version":{"const":"0.1"},
    "registry_version":{"type":"string","minLength":1},
    "current_cve_record_format":{"type":"string","pattern":"^5\\.[0-9]+(?:\\.[0-9]+)?$"},
    "current_epss_model":{"type":"string","pattern":"^EPSS-v[0-9]+$"},
    "epss_v5_effective_date":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"},
    "profiles":{
      "type":"array","minItems":1,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["profile_ref","csaf_version","maturity","standard","schema_uri","document_category","native_cvss_v4","native_epss","native_ssvc_v2","native_first_known_exploitation_dates"],
        "properties":{
          "profile_ref":{"type":"string","pattern":"^advisory-csaf-[a-z0-9-]+@[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "csaf_version":{"enum":["2.0","2.1"]},
          "maturity":{"enum":["stable","provisional"]},
          "standard":{"type":"string","minLength":1},
          "schema_uri":{"type":"string","pattern":"^https://"},
          "document_category":{"const":"csaf_security_advisory"},
          "native_cvss_v4":{"type":"boolean"},
          "native_epss":{"type":"boolean"},
          "native_ssvc_v2":{"type":"boolean"},
          "native_first_known_exploitation_dates":{"type":"boolean"}
        }
      }
    }
  }
}
