{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://endtoendeverywhere.org/e2eesa/schemas/negotiation-policy.schema.json",
  "title": "E2EESA Negotiation Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "protocol_id",
    "protocol_versions",
    "minimum_protocol_version",
    "cryptographic_registry_version",
    "permitted_suite_ids",
    "effective_profile_refs",
    "required_transcript_fields",
    "require_highest_mutual_version",
    "prohibit_fallback_retry",
    "nonce_bytes"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "policy_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "protocol_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "protocol_versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "minimum_protocol_version": {
      "type": "string",
      "minLength": 1
    },
    "cryptographic_registry_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "permitted_suite_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^SUITE-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
      }
    },
    "effective_profile_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*@[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
      }
    },
    "required_transcript_fields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "require_highest_mutual_version": {
      "type": "boolean",
      "const": true
    },
    "prohibit_fallback_retry": {
      "type": "boolean",
      "const": true
    },
    "nonce_bytes": {
      "type": "integer",
      "minimum": 16,
      "maximum": 64
    }
  }
}
