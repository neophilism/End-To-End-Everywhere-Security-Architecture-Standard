{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://endtoendeverywhere.org/e2eesa/schemas/formal-verification-registry.schema.json",
  "title": "E2EESA Formal Verification Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_version", "profiles"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "registry_version": {"type": "string", "minLength": 1},
    "profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile_ref", "proof_kind", "supports_unbounded_sessions", "requires_machine_checking", "description"],
        "properties": {
          "profile_ref": {"type": "string", "pattern": "^formal-[a-z0-9-]+@[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "proof_kind": {"enum": ["symbolic-protocol", "computational", "code-refinement"]},
          "supports_unbounded_sessions": {"type": "boolean"},
          "requires_machine_checking": {"type": "boolean"},
          "description": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
