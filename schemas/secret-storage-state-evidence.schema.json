{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"https://e2eesa.example/schemas/secret-storage-state-evidence.schema.json",
 "title":"E2EESA secret-storage state evidence",
 "type":"object","additionalProperties":false,
 "required":[
  "schema_version","evidence_id","profile_ref","mechanism_id","device_id","vault_id",
  "vault_generation","previous_vault_generation","vault_aead_algorithm_id",
  "root_key_non_exportable","root_key_hardware_isolated","attestation_verified",
  "key_use_authorization_verified","user_authentication_verified","user_presence_verified",
  "vault_authentication_verified","plaintext_secret_at_rest","root_key_exported",
  "raw_root_key_cloud_synced","rollback_anchor_mode","rollback_anchor_value",
  "previous_rollback_anchor_value","rollback_anchor_verified",
  "software_secret_supplied_locally","argon2_derived_locally"
 ],
 "properties":{
  "schema_version":{"const":"0.1"},
  "evidence_id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
  "profile_ref":{"enum":["secret-platform-keystore@0.1.0","secret-hardware-isolated@0.1.0","secret-external-token@0.1.0","secret-software-vault@0.1.0"]},
  "mechanism_id":{"type":"string","pattern":"^SECRET-[A-Z0-9.-]+$"},
  "device_id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
  "vault_id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
  "vault_generation":{"type":"integer","minimum":1},
  "previous_vault_generation":{"oneOf":[{"type":"null"},{"type":"integer","minimum":1}]},
  "vault_aead_algorithm_id":{"enum":["ALG-AES-256-GCM","ALG-CHACHA20-POLY1305","ALG-AES-256-GCM-SIV"]},
  "root_key_non_exportable":{"type":"boolean"},
  "root_key_hardware_isolated":{"type":"boolean"},
  "attestation_verified":{"type":"boolean"},
  "key_use_authorization_verified":{"type":"boolean"},
  "user_authentication_verified":{"type":"boolean"},
  "user_presence_verified":{"type":"boolean"},
  "vault_authentication_verified":{"type":"boolean"},
  "plaintext_secret_at_rest":{"type":"boolean"},
  "root_key_exported":{"type":"boolean"},
  "raw_root_key_cloud_synced":{"type":"boolean"},
  "rollback_anchor_mode":{"enum":["none","hardware-monotonic","independent-witness"]},
  "rollback_anchor_value":{"oneOf":[{"type":"null"},{"type":"integer","minimum":1}]},
  "previous_rollback_anchor_value":{"oneOf":[{"type":"null"},{"type":"integer","minimum":1}]},
  "rollback_anchor_verified":{"type":"boolean"},
  "software_secret_supplied_locally":{"type":"boolean"},
  "argon2_derived_locally":{"type":"boolean"}
 }
}
